# DS Forever helper settings. Everything is optional; defaults work for WoW Forever installed with
# Battle.net as a non-Steam game under Proton.

# Let the helper type the Moonlight PIN into Sunshine for you (your Sunshine web UI login):
#SUNSHINE_USER=
#SUNSHINE_PASS=

# Name the Thor shows for this PC:
#DSF_PC_NAME=My PC

# WoW somewhere unusual (the _forever_ folder):
#DSF_WOW_DIR=/path/to/World of Warcraft/_forever_

# WoW not in a Steam/Proton prefix (Lutris, Heroic, Bottles…): a command that starts it:
#DSF_START_CMD=lutris lutris:rungame/battlenet
